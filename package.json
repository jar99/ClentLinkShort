{
  "name": "clent",
  "version": "1.0.0",
  "description": "A stateless URL shortener codec — the destination is packed into the link, so nothing is ever stored",
  "type": "module",
  "license": "MIT",
  "main": "./src/clent.js",
  "types": "./src/clent.d.ts",
  "exports": {
    ".": {
      "types": "./src/clent.d.ts",
      "default": "./src/clent.js"
    },
    "./bits.js": "./src/bits.js",
    "./deflate.js": "./src/deflate.js",
    "./host.js": "./src/host.js",
    "./hostcode.js": "./src/hostcode.js",
    "./hosts.js": "./src/hosts.js",
    "./huffman.js": "./src/huffman.js",
    "./qr.js": "./src/qr.js",
    "./risk.js": "./src/risk.js",
    "./schemes.js": "./src/schemes.js",
    "./sign.js": "./src/sign.js",
    "./templates.js": "./src/templates.js",
    "./text.js": "./src/text.js",
    "./textcode.js": "./src/textcode.js",
    "./tracking.js": "./src/tracking.js",
    "./transport.js": "./src/transport.js"
  },
  "files": [
    "src/bits.d.ts",
    "src/bits.js",
    "src/clent.d.ts",
    "src/clent.js",
    "src/deflate.d.ts",
    "src/deflate.js",
    "src/host.d.ts",
    "src/host.js",
    "src/hostcode.d.ts",
    "src/hostcode.js",
    "src/hosts.d.ts",
    "src/hosts.js",
    "src/huffman.d.ts",
    "src/huffman.js",
    "src/qr.d.ts",
    "src/qr.js",
    "src/risk.d.ts",
    "src/risk.js",
    "src/schemes.d.ts",
    "src/schemes.js",
    "src/sign.d.ts",
    "src/sign.js",
    "src/templates.d.ts",
    "src/templates.js",
    "src/text.d.ts",
    "src/text.js",
    "src/textcode.d.ts",
    "src/textcode.js",
    "src/tracking.d.ts",
    "src/tracking.js",
    "src/transport.d.ts",
    "src/transport.js"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:corpus": "node --test test/corpus.test.js",
    "corpus:fetch": "node tools/fetch-corpus.mjs",
    "validate": "node tools/validate-corpus.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs src",
    "preview": "node tools/build.mjs && node tools/serve.mjs dist",
    "test:browser": "node tools/browser-test.mjs dist",
    "coverage": "node tools/coverage.mjs",
    "coverage:sweep": "node tools/coverage.mjs --sweep",
    "types": "tsc --noEmit"
  },
  "keywords": [
    "url-shortener",
    "stateless",
    "serverless",
    "compression",
    "base64url",
    "deflate",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jar99/ClentLinkShort.git"
  },
  "devDependencies": {},
  "dependencies": {}
}
